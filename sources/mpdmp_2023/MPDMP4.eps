[1 0 0 1 0 0] CT
N
0 -131 M
875 -131 L
875 525 L
0 525 L
0 -131 L
cp
clip
GS
0 0 translate
700 525 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 525
  /ImageMatrix [700 0 0 525 0 0]
  /Width 700
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
