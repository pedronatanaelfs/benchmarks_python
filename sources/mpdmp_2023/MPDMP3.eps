/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 525
  /ImageMatrix [700 0 0 525 0 0]
  /Width 700
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
